# Copy to passwords.yaml (gitignored) and replace every value.
# Without this file the server and `dart test test/integration` exit silently.
shared:
  geminiApiKey: ''
  sarvamApiKey: ''
  demoSeedToken: 'change-me'
# Live smoke: GEMINI_MODEL=gemini-3.5-flash-lite (free-tier friendly) or gemini-3.5-flash

development:
  database: 'any-long-random-string'
  serviceSecret: 'any-long-random-string'
  jwtRefreshTokenHashPepper: 'any-long-random-string'
  jwtHmacSha512PrivateKey: 'any-long-random-string'
  emailSecretHashPepper: 'any-long-random-string'

test:
  database: 'any-long-random-string'
  serviceSecret: 'any-long-random-string'
  jwtRefreshTokenHashPepper: 'any-long-random-string'
  jwtHmacSha512PrivateKey: 'any-long-random-string'
  emailSecretHashPepper: 'any-long-random-string'
